generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Énumérations ─────────────────────────
enum Role {
  STUDENT
  TRAINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum Category {
  LANGUAGES
  OFFICE
  EDUCTOUR
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
}

// ───────────────────────── Utilisateurs ─────────────────────────
model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique // toujours stocké en minuscules, sans espaces
  passwordHash String
  role         Role       @default(STUDENT) // un seul rôle par utilisateur
  status       UserStatus @default(ACTIVE) // désactivé plutôt que supprimé
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  coursesCreated     Course[]         @relation("CourseCreator")
  courseTrainers     CourseTrainer[]
  enrollments        Enrollment[]
  progress           LessonProgress[]
  submissions        Submission[]     @relation("SubmissionStudent")
  gradedSubmissions  Submission[]     @relation("SubmissionGrader")
  classStudents      ClassStudent[]
  classTrainers      ClassTrainer[]
  files              FileAsset[]
  classesCreated     TrainingClass[]
  assignmentsCreated Assignment[]

  @@index([role, status])
  @@map("users")
}

// ───────────────────────── Structure pédagogique ─────────────────────────
model Course {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @default("") @db.Text
  category    Category
  status      ContentStatus @default(DRAFT)
  coverFileId String?       @unique
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  publishedAt DateTime?

  createdBy   User            @relation("CourseCreator", fields: [createdById], references: [id])
  coverFile   FileAsset?      @relation(fields: [coverFileId], references: [id])
  trainers    CourseTrainer[]
  modules     Module[]
  enrollments Enrollment[]
  classes     TrainingClass[]
  assignments Assignment[]

  @@index([status, category]) // requête du catalogue
  @@map("courses")
}

// Périmètre d'un Trainer : il ne gère que les cours où il figure ici
model CourseTrainer {
  courseId   String
  userId     String
  assignedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_trainers")
}

model Module {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  description String?       @db.Text
  position    Int
  status      ContentStatus @default(DRAFT)

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]

  @@index([courseId, position])
  @@map("modules")
}

model Lesson {
  id       String        @id @default(cuid())
  moduleId String
  title    String
  content  String        @default("") @db.Text // Markdown en MVP
  position Int
  status   ContentStatus @default(DRAFT)

  module      Module           @relation(fields: [moduleId], references: [id])
  resources   Resource[]
  assignments Assignment[]
  progress    LessonProgress[]

  @@index([moduleId, position])
  @@map("lessons")
}

// ───────────────────────── Fichiers et ressources ─────────────────────────
model FileAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique // nom généré (UUID) ; jamais le nom d'origine sur disque
  originalName String
  mimeType     String
  sizeBytes    Int // ≤ 50 Mo, contrôlé côté serveur
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User                  @relation(fields: [uploadedById], references: [id])
  course     Course?
  resource   Resource?
  attachment AssignmentAttachment?
  submission Submission?

  @@map("file_assets")
}

model Resource {
  id        String   @id @default(cuid())
  lessonId  String
  fileId    String   @unique
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  lesson Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file   FileAsset @relation(fields: [fileId], references: [id])

  @@index([lessonId])
  @@map("resources")
}

// ───────────────────────── Inscriptions et progression ─────────────────────────
model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId]) // pas de double inscription
  @@index([courseId])
  @@map("enrollments")
}

// Porte à la fois « leçon terminée » (completedAt) et « reprendre » (lastViewedAt)
model LessonProgress {
  id           String    @id @default(cuid())
  userId       String
  lessonId     String
  courseId     String // dénormalisé : accélère « reprendre » et le calcul par cours
  lastViewedAt DateTime  @default(now())
  completedAt  DateTime? // null = consultée mais non terminée

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, courseId, lastViewedAt])
  @@map("lesson_progress")
}

// ───────────────────────── Classes (organisation uniquement) ─────────────────────────
model TrainingClass {
  id          String   @id @default(cuid())
  name        String
  courseId    String
  createdById String
  createdAt   DateTime @default(now())

  course    Course         @relation(fields: [courseId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  students  ClassStudent[]
  trainers  ClassTrainer[]

  @@index([courseId])
  @@map("training_classes")
}

model ClassStudent {
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
  @@map("class_students")
}

model ClassTrainer {
  classId  String
  userId   String
  joinedAt DateTime @default(now())

  class TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
  @@map("class_trainers")
}

// ───────────────────────── Devoirs ─────────────────────────
model Assignment {
  id           String        @id @default(cuid())
  courseId     String // dénormalisé : périmètre Trainer et écran Corrections
  lessonId     String? // « devoir associé » affiché dans la leçon
  title        String
  instructions String        @db.Text
  dueDate      DateTime
  status       ContentStatus @default(DRAFT)
  createdById  String
  createdAt    DateTime      @default(now())

  course      Course                 @relation(fields: [courseId], references: [id])
  lesson      Lesson?                @relation(fields: [lessonId], references: [id])
  createdBy   User                   @relation(fields: [createdById], references: [id])
  attachments AssignmentAttachment[]
  submissions Submission[]

  @@index([courseId])
  @@index([lessonId])
  @@map("assignments")
}

model AssignmentAttachment {
  assignmentId String
  fileId       String @unique

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  file       FileAsset  @relation(fields: [fileId], references: [id])

  @@id([assignmentId, fileId])
  @@map("assignment_attachments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  fileId       String           @unique
  submittedAt  DateTime         @default(now()) // mis à jour lors d'un remplacement
  status       SubmissionStatus @default(SUBMITTED)
  grade        Decimal?         @db.Decimal(4, 2) // facultative, entre 0 et 20 (contrainte SQL ajoutée à la migration)
  feedback     String?          @db.Text
  gradedById   String?
  gradedAt     DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation("SubmissionStudent", fields: [studentId], references: [id])
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id])
  file       FileAsset  @relation(fields: [fileId], references: [id])

  @@unique([assignmentId, studentId]) // UNE seule soumission active
  @@index([studentId])
  @@index([assignmentId, status]) // écran Corrections : filtre « À corriger »
  @@map("submissions")
}
